    },
    "Сама сесія не зупиниться — вона лише зникне зі списку. ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session itself keeps running — it only disappears from the list. "
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotná relace poběží dál — jen zmizí ze seznamu. "
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сама сесія не зупиниться — вона лише зникне зі списку. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сама сессия не остановится — она лишь исчезнет из списка. "
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессияның өзі тоқтамайды — ол тек тізімнен жоғалады. "
          }
        }
      }
    },
    "Сесію відкрито до встановлення хуків — перезапусти її, щоб отримувати сповіщення": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was opened before the hooks were installed — restart it to get notifications"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace byla otevřena před instalací hooků — restartuj ji, ať chodí notifikace"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесію відкрито до встановлення хуків — перезапусти її, щоб отримувати сповіщення"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия открыта до установки хуков — перезапусти её, чтобы получать уведомления"
          }
        },
        "kk": {
          "stringUnit": {
