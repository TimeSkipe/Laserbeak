    "Дані йдуть прямо між пристроями й зашифровані. Роутер не потрібен.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data travels directly between devices, encrypted. No router needed."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tečou přímo mezi zařízeními a jsou šifrovaná. Router není potřeba."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані йдуть прямо між пристроями й зашифровані. Роутер не потрібен."
          }
        }
      }
    },
