    "Claude підсумує розмову й почне з коротшого контексту. ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude will summarise the conversation and continue with a shorter context. "
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude shrne konverzaci a bude pokračovat s kratším kontextem. "
