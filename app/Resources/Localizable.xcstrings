    "Мова й налаштування збережуться: установка бере їх із config.json. Програма перезапуститься сама.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your language and settings stay: the install takes them from config.json. The app relaunches by itself."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk i nastavení zůstanou: instalace je převezme z config.json. Aplikace se restartuje sama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова й налаштування збережуться: установка бере їх із config.json. Програма перезапуститься сама."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык и настройки сохранятся: установка берёт их из config.json. Приложение перезапустится само."
          }
        },
        "kk": {
