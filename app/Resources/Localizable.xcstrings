    "Claude підсумує розмову й почне з коротшого контексту. ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude will summarise the conversation and continue with a shorter context. "
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude shrne konverzaci a bude pokračovat s kratším kontextem. "
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude підсумує розмову й почне з коротшого контексту. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude подытожит разговор и продолжит с более коротким контекстом. "
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude әңгімені қорытындылап, қысқарақ контекстпен жалғастырады. "
          }
        }
      }
    },
    "Claude сам вирішує, що безпечно виконати": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude decides for itself what is safe to run"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sám rozhodne, co je bezpečné spustit"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude сам вирішує, що безпечно виконати"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude сам решает, что безопасно выполнить"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нені орындау қауіпсіз екенін Claude өзі шешеді"
          }
        }
      }
    },
    "Claude чи Codex завершили хід і чекають на тебе": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude or Codex finished a turn and is waiting for you"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude nebo Codex dokončil tah a čeká na tebe"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude чи Codex завершили хід і чекають на тебе"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude или Codex завершил ход и ждёт тебя"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude не Codex жүрісін аяқтап, сені күтіп тұр"
          }
        }
      }
    },
    "macOS не дозволяє програмі показувати сповіщення": {
